<Window x:Class="EclipseClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eclipse Client"
        Width="920" Height="620" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Border x:Name="RootBorder" CornerRadius="16" Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- Sidebar -->
            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    CornerRadius="16,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,20,16,24">
                        <TextBlock Text="Eclipse" FontFamily="{StaticResource MainFont}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Client" FontFamily="{StaticResource MainFont}"
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>

                    <StackPanel x:Name="NavPanel" Grid.Row="1">
                        <RadioButton x:Name="TabSpvp" Style="{StaticResource SidebarTab}"
                                     GroupName="Nav" IsChecked="True" Checked="Tab_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊕" Margin="0,0,10,0" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="SPVP"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabMace" Style="{StaticResource SidebarTab}"
                                     GroupName="Nav" Checked="Tab_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚒" Margin="0,0,10,0"/>
                                <TextBlock Text="Mace"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabMisc" Style="{StaticResource SidebarTab}"
                                     GroupName="Nav" Checked="Tab_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Margin="0,0,10,0"/>
                                <TextBlock Text="Misc"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabCustomize" Style="{StaticResource SidebarTab}"
                                     GroupName="Nav" Checked="Tab_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◉" Margin="0,0,10,0"/>
                                <TextBlock Text="Customize"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabAdmin" Style="{StaticResource SidebarTab}"
                                     GroupName="Nav" Checked="Tab_Changed"
                                     Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="★" Margin="0,0,10,0"/>
                                <TextBlock Text="Admin"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="16,0,16,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ConnText" Text="MC Disconnected"
                                       Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                        </StackPanel>
                        <Button Content="Logout" Style="{StaticResource GlassButton}"
                                FontSize="11" Padding="10,6" Click="Logout_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Title Bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Grid.Column="1" Background="#06FFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBox x:Name="SearchBox" Width="200" Style="{StaticResource GlassTextBox}"
                             Padding="10,6" FontSize="12"
                             TextChanged="SearchBox_TextChanged">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="-28,0,0,0"
                               Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False"/>
                </StackPanel>

                <Button Grid.Column="1" Content="⚡ Inject" Style="{StaticResource AccentButton}"
                        FontSize="11" Padding="12,6" Margin="8,0"
                        Click="Inject_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button Content="─" Style="{StaticResource TitleBarButton}" Click="Minimize_Click"/>
                    <Button Content="□" Style="{StaticResource TitleBarButton}" Click="Maximize_Click"/>
                    <Button Content="✕" Style="{StaticResource CloseButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Padding="20,12,20,12">
                <StackPanel x:Name="ContentPanel"/>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Grid.Column="1" Background="#08FFFFFF"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FooterConn" Text="MC Disconnected"
                                   Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,20,0"/>
                        <TextBlock x:Name="FooterFps" Text="FPS: --" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,20,0"/>
                        <TextBlock x:Name="FooterRam" Text="RAM: -- MB" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,20,0"/>
                        <TextBlock x:Name="FooterCpu" Text="CPU: --%" Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                    </StackPanel>
                    <TextBlock x:Name="InjectStatus" Text="" HorizontalAlignment="Right"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource SuccessBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
