<Window x:Class="EclipseClient.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eclipse Client - Login"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Border CornerRadius="20" Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="#08FFFFFF">
                <TextBlock Text="Eclipse Client" Foreground="{StaticResource TextDimBrush}"
                           FontFamily="{StaticResource MainFont}" FontSize="11"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Content="✕" Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Right" Margin="0,0,8,0"
                        Click="Close_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="40,20,40,40" VerticalAlignment="Center">
                <!-- Logo -->
                <TextBlock Text="ECLIPSE" FontFamily="{StaticResource MainFont}"
                           FontSize="32" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="External CPVP Client" FontFamily="{StaticResource MainFont}"
                           FontSize="12" Foreground="{StaticResource TextDimBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <TextBlock Text="Email" Foreground="{StaticResource TextDimBrush}"
                           FontSize="12" Margin="0,0,0,6"/>
                <TextBox x:Name="EmailBox" Style="{StaticResource GlassTextBox}" Margin="0,0,0,16"/>

                <TextBlock Text="Password" Foreground="{StaticResource TextDimBrush}"
                           FontSize="12" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource GlassPasswordBox}" Margin="0,0,0,12"/>

                <CheckBox x:Name="RememberMeBox" Content="Remember me"
                          Foreground="{StaticResource TextDimBrush}"
                          FontFamily="{StaticResource MainFont}" FontSize="12"
                          Margin="0,0,0,20"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="Collapsed"/>

                <Button Content="Sign In" Style="{StaticResource AccentButton}"
                        Click="Login_Click" Margin="0,0,0,12"/>

                <TextBlock Text="v1.0.0  •  External Injection Client"
                           Foreground="{StaticResource TextDimBrush}" FontSize="10"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
