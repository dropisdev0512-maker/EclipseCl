<Application x:Class="EclipseClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EclipseClient.Converters"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis"/>
            <conv:AccentBrushConverter x:Key="AccentBrushConv"/>
            <conv:ConnectionStatusConverter x:Key="ConnStatus"/>
            <conv:ConnectionColorConverter x:Key="ConnColor"/>

            <SolidColorBrush x:Key="BgBrush" Color="#D808080E"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#90101018"/>
            <SolidColorBrush x:Key="SidebarBrush" Color="#A00A0A12"/>
            <SolidColorBrush x:Key="TextBrush" Color="#E6EBFF"/>
            <SolidColorBrush x:Key="TextDimBrush" Color="#8C91AA"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#409CFF"/>
            <SolidColorBrush x:Key="AccentDimBrush" Color="#50409CFF"/>
            <SolidColorBrush x:Key="AccentGlowBrush" Color="#A0409CFF"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#FF5252"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#40FF80"/>
            <FontFamily x:Key="MainFont">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
